# LLM API Keys
OPENAI_API_KEY=sk-xxx
GOOGLE_API_KEY=xxx
ANTHROPIC_API_KEY=sk-ant-xxx

# Database
DATABASE_URL=postgresql+asyncpg://scienceai:scienceai@localhost:5432/scienceai

# Redis
REDIS_URL=redis://localhost:6379/0

# Embedding
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Qdrant
QDRANT_URL=http://localhost:6333

# LLM Backend: "cli" (free, uses local CLI tools) or "api" (paid, uses API keys)
LLM_BACKEND=cli

# CLI command overrides
CLI_CODEX_COMMAND=codex
CLI_ANTIGRAVITY_COMMAND=agy
CLI_CLAUDE_COMMAND=claude
CLI_TIMEOUT_SECONDS=240

# Orchestrator: "graph" (LangGraph, default) or "legacy" (deprecated)
ORCHESTRATOR_MODE=graph

# Durable graph checkpointer (psycopg v3 DSN). Empty = in-memory (no durability).
# Set to enable resume-after-restart for human-in-the-loop sessions:
# CHECKPOINTER_DSN=postgresql://scienceai:scienceai@localhost:5432/scienceai
CHECKPOINTER_DSN=

# Max concurrent agent calls per parallel fan-out stage (deep read / critique)
FANOUT_CONCURRENCY=5

# Comma-separated allowed CORS origins for the dashboard
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Cost tracking
COST_BUDGET_USD=10.0
